          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "The column \"status\" of the scores file is not a column the tool reads, so the values under it are not checked. Fix: Correct the name to a column of docs/inputs.md, or leave the column in if it is for your own use."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/scores.csv",
                  "index": 0
