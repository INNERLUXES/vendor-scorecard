        {
          "ruleId": "red-flag-raised",
          "ruleIndex": 19,
          "level": "warning",
          "message": {
            "text": "The vendor \"Vendor Alpha\" has a red flag for the criterion \"Security practice\" in row 3. Note: \"Signing key held by one person only\". Fix: Read the note and decide, as a person, what the red flag means for the shortlist. The tool does not drop a vendor and does not change a score for it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/scores.csv",
                  "index": 0
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 46
                }
              }
            }
          ],
          "properties": {
            "kind": "row",
            "subject": "Vendor Alpha / Security practice"
          }
        },
        {
          "ruleId": "evidence-missing",
          "ruleIndex": 17,
